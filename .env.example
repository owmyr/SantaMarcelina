# Supabase — copie para .env e preencha com o projeto em https://supabase.com
# Mantém token= na URL; Supabase é usado só para sync tempo real (fallback é BroadcastChannel local)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SEU_ANON_KEY_AQUI

# Config padrão (também pode ser mudada em /admin → Config)
# VITE_DEFAULT_SENHA=santa2026
